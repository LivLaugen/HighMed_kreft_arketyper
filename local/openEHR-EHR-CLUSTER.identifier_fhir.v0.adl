	term_definitions = <
		["de"] = <
			items = <
				["at0000"] = <
					text = <"Identifier">
					description = <"Identifizierungsdetails, die auf FHIR-Ressourcen oder Datentypen abgestimmt sind. ">
				>
				["at0001"] = <
					text = <"Identifier">
					description = <"Identifikator">
					comment = <"Identifizierungsdetails">
				>
			>
		>
	>
